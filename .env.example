# PostgreSQL example (uncomment and configure when ready)
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=recruiters_db
DATABASE_USER=postgres
DATABASE_PASSWORD=admin
DATABASE_HOST=localhost
DATABASE_PORT=5432

